# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — .env.example (this file) is tracked and must
# only ever contain placeholders, never real credentials.

# Supabase project settings (Settings -> API in the Supabase dashboard).
# VITE_SUPABASE_ANON_KEY is the public "anon" key, safe to expose client-side
# — it's designed for that, and access is enforced by Row-Level Security
# policies on the database, not by keeping this key secret. Never put the
# service-role key or database password in a VITE_-prefixed variable, or
# anywhere in this app's client code at all — those belong only on a server
# you control, never shipped to a browser or device.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
