# Public feature controls. Generic preparation and universal exports remain enabled
# by default; OCR and submission adapters remain disabled by default.
VITE_FILESMART_ENABLE_NATIONAL_JURISDICTIONS=true
VITE_FILESMART_ENABLE_GENERIC_PREPARATION=true
VITE_FILESMART_ENABLE_UNIVERSAL_EXPORTS=true
VITE_FILESMART_ENABLE_DEADLINE_TRACKER=true
VITE_FILESMART_ENABLE_OCR=false
VITE_FILESMART_ENABLE_SUBMISSION_ADAPTERS=false

# Optional public capability-registry endpoint. If unset, the bundled registry is used.
VITE_JURISDICTION_CAPABILITIES_ENDPOINT=

# Optional managed OCR boundary. If unset, receipt capture falls back to manual entry.
# This must be a trusted server-side boundary; do not put provider credentials here.
VITE_OCR_ENDPOINT=
