# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — real values only ever go in .env, which is never committed.
# .env.example is tracked and must only ever contain placeholder values.
.env
.env.*
!.env.example

# Supabase CLI's local link/session cache — machine-specific, not secrets
# per se, but not something to commit either.
supabase/.temp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
